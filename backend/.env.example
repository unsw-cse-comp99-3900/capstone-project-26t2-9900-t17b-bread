# Copy to .env and adjust as needed.

# Comma-separated list of allowed CORS origins for the React frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# HTTP client settings for article fetching.
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=5000000
FETCH_USER_AGENT=Mozilla/5.0 (compatible; NarrativeDiffBot/0.1; +https://example.edu)

# Preprocessing limits.
MIN_SENTENCE_CHARS=15
