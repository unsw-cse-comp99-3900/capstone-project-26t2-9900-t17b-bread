# Copy to .env and adjust as needed.

# Comma-separated list of allowed CORS origins for the React frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# HTTP client settings for article fetching.
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=5000000
FETCH_USER_AGENT=Mozilla/5.0 (compatible; NarrativeDiffBot/0.1; +https://example.edu)

# Preprocessing limits.
MIN_SENTENCE_CHARS=15

# OCR for scanned/image PDFs (pdf-to-word + auto OCR on upload).
# Requires the Tesseract engine installed separately (pytesseract is only a wrapper).
#   Windows: winget install -e --id UB-Mannheim.TesseractOCR
#   macOS:   brew install tesseract
#   Ubuntu:  sudo apt-get install tesseract-ocr
# Set TESSERACT_CMD only if the binary is not on PATH (Windows default shown below).
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Language packs, e.g. "eng" or "eng+chi_sim".
OCR_LANGUAGES=eng

# PostgreSQL connection. Leave empty to disable persistence (API still works).
# The database developer sets this when integrating with the backend.
# Accepts postgresql:// or postgresql+psycopg:// — the async driver is added automatically.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres
